def recalculate_tss(base_salary: float, public_min_wage: float = 10000.00) -> dict:
    # Ley 87-01: Topes de salarios mínimos legales
    TOPE_SFS = public_min_wage * 10
    TOPE_AFP = public_min_wage * 20
    
    base_sfs = min(base_salary, TOPE_SFS)
    base_afp = min(base_salary, TOPE_AFP)
    
    calc_sfs = round(base_sfs * 0.0304, 2)
    calc_afp = round(base_afp * 0.0287, 2)
    
    return {
        "sfs_employee": calc_sfs,
        "afp_employee": calc_afp,
        "overcapped": base_salary > TOPE_SFS or base_salary > TOPE_AFP
    }
